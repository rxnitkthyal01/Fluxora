PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/fluxora.sqlite
# Optional: provide 64 hex characters. If omitted, Fluxora creates a random key in the OS user config directory.
# FLUXORA_ENCRYPTION_KEY=
# FLUXORA_KEY_DIRECTORY=
# Optional one-time setup key for creating the first account manually. Keep this secret outside the repository.
# FLUXORA_AUTH_SETUP_KEY=
# Optional one-time administrator bootstrap credentials. Remove the password after the first successful startup.
# FLUXORA_ADMIN_USERNAME=fluxora-admin
# FLUXORA_ADMIN_PASSWORD=replace-with-a-long-random-password
CLIENT_ORIGIN=http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,::1
# For non-loopback deployments set COOKIE_SECURE=true and terminate HTTPS at a trusted reverse proxy.
# COOKIE_SECURE=false
# TRUST_PROXY=1
MAX_DELAY_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
